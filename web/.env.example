# Copy to .env. Values prefixed with VITE_ are embedded in the build and are public.

# Full web API base URL, without a trailing slash.
# Leave empty during local development to use the Vite proxy below.
VITE_API_BASE_URL=
# VITE_API_BASE_URL=https://<API_HOST>/api/v1/web_api

# Address the dev/preview proxy forwards /api requests to (local API).
API_PROXY_TARGET=http://127.0.0.1:8000

VITE_APP_NAME=Firefighter Safety Data Hub
